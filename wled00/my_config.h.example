/*
 * Apollo M-1 developer secrets template.
 *
 * The factory apollo_m1 build ships with no credentials: open setup AP and no
 * pre-set WiFi. For internal development or bench builds that should join a
 * network automatically:
 *
 *   1. copy this file to wled00/my_config.h   (gitignored, never commit it)
 *   2. build with the flag -D WLED_USE_MY_CONFIG
 *      (e.g. add it to build_flags in a private platformio_override.ini env)
 *
 * Do not put real credentials in any committed file.
 */

